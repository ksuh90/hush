<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <ImageButton
        android:id="@+id/cancel"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bubble_cancel"
        android:contentDescription="@string/bubble_cancel"
        android:elevation="3dp"
        android:src="@drawable/ic_close"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <View
            android:id="@+id/halo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bubble_halo"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/mic"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/bubble_mic_idle"
            android:contentDescription="@string/bubble_start"
            android:elevation="3dp"
            android:src="@drawable/ic_mic" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:elevation="4dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/on_bubble"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/confirm"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bubble_confirm"
        android:contentDescription="@string/bubble_confirm"
        android:elevation="3dp"
        android:src="@drawable/ic_check"
        android:visibility="gone" />
</LinearLayout>
