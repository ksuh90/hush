<?xml version="1.0" encoding="utf-8"?>
<!-- The ghost window: a 52 dp disc in an 80 dp frame for the gold ring. X and the check have their own windows
     (bubble_button.xml), so this window never changes size. The padding leaves space for the shadow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="6dp">

    <app.hush.VoiceRing
        android:id="@+id/ring"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:importantForAccessibility="no" />

    <ImageButton
        android:id="@+id/mic"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:background="@drawable/bubble_ghost"
        android:contentDescription="@string/bubble_start"
        android:elevation="3dp" />

    <!-- Drawn on top of the disc. It takes no touches, so taps and drags go to the disc. -->
    <app.hush.GhostView
        android:id="@+id/ghost"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:elevation="3dp"
        android:importantForAccessibility="no" />
</FrameLayout>
