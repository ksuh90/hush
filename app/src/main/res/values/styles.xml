<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Hush.Title" parent="">
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Large</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Hush.Step" parent="">
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">28dp</item>
    </style>

    <style name="Hush.Status" parent="">
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="Hush.Body" parent="">
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Small</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>
