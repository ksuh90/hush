<?xml version="1.0" encoding="utf-8"?>
<!-- A 40 dp chip in a 48 dp touch row. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetTop="4dp" android:insetBottom="4dp">
    <selector>
        <item android:state_enabled="false">
            <shape android:shape="rectangle">
                <solid android:color="@color/off_fill" />
                <corners android:radius="20dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/chip" />
                <stroke android:width="1dp" android:color="@color/line" />
                <corners android:radius="20dp" />
            </shape>
        </item>
    </selector>
</inset>
